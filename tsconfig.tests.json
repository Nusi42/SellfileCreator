{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "tmp/tsc/tests",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "target": "ES2020",
    "lib": ["ES2020", "ES2022.Error", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/lib/hsfBuilder.ts",
    "src/lib/types.ts",
    "src/lib/hsfTypes.ts",
    "src/lib/importers/gearDbNormalizer.ts",
    "src/lib/importers/gearDbImporter.ts",
    "src/lib/configDiff.ts",
    "src/types/**/*.d.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/benchmarks/**/*.ts",
    "tests/repro/**/*.ts",
    "tests/**/*.d.ts"
  ]
}
