{
    "name":  "rsl-sellfile-creator",
    "version":  "0.9.17-dev",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "postinstall":  "npx playwright install",
                    "generate:third-party-notices":  "node scripts/tooling/update-third-party-notices.mjs",
                    "export:l10n":  "tsc -p tsconfig.scripts.json \u0026\u0026 node scripts/tooling/patch-esm-specifiers.cjs \u0026\u0026 node tmp/tsc/scripts/scripts/tooling/export-catalogs.js",
                    "measure:rule-tester":  "tsc -p tsconfig.scripts.json \u0026\u0026 node scripts/tooling/patch-esm-specifiers.cjs \u0026\u0026 node tmp/tsc/scripts/scripts/tooling/measure-rule-tester.js",
                    "lint":  "eslint . --ext .ts,.tsx",
                    "release:win":  "powershell -ExecutionPolicy Bypass -File ./scripts/release/release-win.ps1",
                    "release:win-dev":  "powershell -ExecutionPolicy Bypass -File ./scripts/release/release-win-dev.ps1",
                    "release-notes:catchup":  "bash ./scripts/release/run-release-notes-catchup.sh",
                    "tauri":  "tauri",
                    "tauri:dev":  "tauri dev",
                    "tauri:build":  "tauri build",
                    "test:unit":  "node scripts/test/run-tests.mjs",
                    "test:e2e:chromium":  "playwright test --project=chromium",
                    "test:e2e:firefox":  "playwright test --project=firefox",
                    "test:e2e:webkit":  "playwright test --project=webkit",
                    "test:e2e":  "node scripts/test/run-e2e.mjs",
                    "test:e2e:all":  "npm run test:e2e",
                    "test:all":  "npm run test:unit \u0026\u0026 npm run test:e2e",
                    "test:all:full":  "npm run test:unit \u0026\u0026 npm run test:e2e:all",
                    "test":  "npm run test:all",
                    "tests:extract":  "tsc -p tsconfig.tests.json \u0026\u0026 node scripts/tooling/patch-esm-specifiers.cjs \u0026\u0026 node scripts/test/dump-tests-hsfc.mjs"
                },
    "overrides":  {
                      "esbuild":  "\u003e=0.24.3"
                  },
    "dependencies":  {
                         "@emotion/react":  "^11.14.0",
                         "@emotion/styled":  "^11.14.1",
                         "@mui/icons-material":  "^7.3.2",
                         "@mui/material":  "^7.3.2",
                         "@tanstack/react-virtual":  "^3.13.12",
                         "@types/node":  "^24.8.1",
                         "@uiw/react-markdown-preview":  "^5.1.1",
                         "@uiw/react-md-editor":  "^4.0.5",
                         "fflate":  "^0.8.2",
                         "react":  "^18.3.1",
                         "react-compiler-runtime":  "^19.1.0-rc.3",
                         "react-dom":  "^18.3.1",
                         "rehype-sanitize":  "^6.0.0",
                         "sql.js":  "^1.11.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.56.1",
                            "@tauri-apps/cli":  "^2.0.0",
                            "@types/react":  "^18.3.4",
                            "@types/react-dom":  "^18.3.0",
                            "@typescript-eslint/eslint-plugin":  "^8.43.0",
                            "@typescript-eslint/parser":  "^8.43.0",
                            "@vitejs/plugin-react":  "^5.1.3",
                            "babel-plugin-react-compiler":  "^19.1.0-rc.3",
                            "baseline-browser-mapping":  "^2.9.11",
                            "eslint":  "^9.35.0",
                            "eslint-import-resolver-typescript":  "^3.10.1",
                            "eslint-plugin-import":  "^2.32.0",
                            "eslint-plugin-react":  "^7.37.5",
                            "eslint-plugin-react-hooks":  "^5.0.0",
                            "eslint-plugin-react-you-might-not-need-an-effect":  "^0.5.1",
                            "terser":  "^5.44.0",
                            "typescript":  "^5.9.2",
                            "vite":  "^7.3.1",
                            "vite-plugin-checker":  "^0.10.3"
                        }
}