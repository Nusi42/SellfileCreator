{
    "name":  "rsl-sellfile-creator",
    "version":  "0.9.3-dev",
    "private":  true,
    "type":  "module",
  "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint . --ext .ts,.tsx",
                    "icons:build":  "node scripts/build-icon-data.mjs",
                    "icons":  "npm run -s icons:build",
                    "icons:rebuild":  "npm run -s icons:build",
                    "release:win":  "powershell -ExecutionPolicy Bypass -File ./scripts/release-win.ps1",
                    "tauri":  "tauri",
                    "tauri:dev":  "tauri dev",
                    "tauri:build":  "tauri build",
                    "test:builder": "tsc -p tsconfig.tests.json && node scripts/patch-esm-specifiers.cjs && node scripts/.tmp/tests/test-hsfBuilder.js"
                },
  "overrides": {
    "esbuild": ">=0.24.3"
  },
    "dependencies":  {
                         "@emotion/react":  "^11.14.0",
                         "@emotion/styled":  "^11.14.1",
                         "@mui/icons-material":  "^7.3.2",
                         "@mui/material":  "^7.3.2",
                         "@uiw/react-markdown-preview":  "^5.1.1",
                         "@uiw/react-md-editor":  "^4.0.5",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "rehype-sanitize":  "^6.0.0"
                     },
    "devDependencies":  {
                            "@tauri-apps/cli":  "^2.0.0",
                            "@types/react":  "^18.3.4",
                            "@types/react-dom":  "^18.3.0",
                            "@typescript-eslint/eslint-plugin":  "^8.43.0",
                            "@typescript-eslint/parser":  "^8.43.0",
                            "@vitejs/plugin-react":  "^5.0.2",
                            "eslint":  "^9.35.0",
                            "eslint-import-resolver-typescript":  "^3.10.1",
                            "eslint-plugin-import":  "^2.32.0",
                            "eslint-plugin-react-hooks":  "^5.0.0",
                            "eslint-plugin-react":  "^7.37.5",
                            "terser":  "^5.44.0",
                            "typescript":  "^5.9.2",
                            "vite":  "^7.1.5",
                            "vite-plugin-checker":  "^0.10.3"
                        }
}
