{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "tmp/tsc/scripts",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/lib/i18n/catalogs/*.ts",
    "scripts/tooling/export-catalogs.ts",
    "scripts/tooling/sync-catalog-comments.ts",
    "scripts/tooling/audit-l10n-widths.ts",
    "scripts/tooling/measure-rule-tester.ts",
    "src/types/globals.d.ts"
  ]
}
