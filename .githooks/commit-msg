#!/bin/sh
# Enforce the commit message rules, then refuse private data in the message and in the
# author/committer identity about to be recorded. The scripts are this hook's checkout's own.
node "$(dirname "$0")/../scripts/tooling/check-commit-msg.mjs" "$1" || exit 1
exec node "$(dirname "$0")/../scripts/tooling/check-private.mjs" --message "$1"
