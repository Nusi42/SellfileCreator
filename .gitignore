# Node
node_modules/
npm-debug.log*
package-lock.json

# Vite builds
dist.app/
dist.web/
wasm/target/
# ts-rs default fallback dir if TS_RS_EXPORT_DIR is unset (e.g. when a dev runs
# `cargo test -p rule_engine_core` directly instead of `npm run wasm:ensure:rule-engine`).
wasm/*/bindings/
src/lib/wasm/generated/

# Build/test artifacts
tmp/tsc/
tmp/gear-db-inspection/
scripts/.tmp/
docs/.release-notes/
# Generated by `npm run generate:third-party-notices` (release builds refresh it).
userDocs/THIRD_PARTY_NOTICES.txt

# OS files
.DS_Store
Thumbs.db

# Release archives (release-win.ps1 writes the versioned zip into releases/)
/releases/
/scripts/mock-export.hsf

old_releases/*-dev.html

# Dev-only inbound-endpoint packet captures (see scripts/vite/packetCapturePlugin.ts).
# Live session recordings AND the local unpack cache for committed capture fixtures.
# Promote a useful session with `npm run fixtures:captures:pack -- <session>` (writes a
# small tar.zst under tests/fixtures/captures/); tests unpack it back here on demand.
/docs/orig/sampleLog/captures/

# Compiled C/C++ smoke-test binary for the native DLL (rebuilt via its Makefile).
/wasm/rule_engine_native/example/run_example
/wasm/rule_engine_native/example/run_example.exe

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
log.txt

