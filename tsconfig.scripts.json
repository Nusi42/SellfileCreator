{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "tmp/tsc/scripts",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "ES2022.Error", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/lib/i18n/catalogs/*.ts",
    "scripts/tooling/export-catalogs.ts",
    "scripts/tooling/catalogAudit.ts",
    "scripts/tooling/sync-catalog-comments.ts",
    "scripts/tooling/audit-l10n-widths.ts",
    "scripts/tooling/measure-gear-inspector.ts",
    "scripts/tooling/sim-improvement-chance.ts",
    "scripts/tooling/instrument-safeguard-piece.ts",
    "scripts/tooling/measure-group-effect.ts",
    "src/types/globals.d.ts"
  ]
}
