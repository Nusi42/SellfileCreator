{
    "name": "rsl-sellfile-creator",
    "version": "1.0.0-dev",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/tooling/run-dev-with-wasm-watch.mjs",
        "dev:vite": "vite",
        "build": "node -e \"console.log('Build started:', new Date().toLocaleString())\" && npm run wasm:ensure:rule-engine && vite build",
        "build:web": "node -e \"console.log('Build started:', new Date().toLocaleString())\" && npm run wasm:ensure:rule-engine && vite build --mode web",
        "preview": "vite preview",
        "typecheck": "npm run wasm:ensure:rule-engine && tsc --noEmit",
        "postinstall": "npm run ensure:wasm-toolchain && npx playwright install",
        "generate:third-party-notices": "node scripts/tooling/update-third-party-notices.mjs",
        "export:l10n": "tsc -p tsconfig.scripts.json && node scripts/tooling/patch-esm-specifiers.cjs && node tmp/tsc/scripts/scripts/tooling/export-catalogs.js",
        "measure:gear-inspector": "tsc -p tsconfig.scripts.json && node scripts/tooling/patch-esm-specifiers.cjs && node tmp/tsc/scripts/scripts/tooling/measure-gear-inspector.js",
        "check:wasm-toolchain": "node scripts/tooling/check-rust-wasm-toolchain.mjs",
        "ensure:wasm-toolchain": "node scripts/tooling/check-rust-wasm-toolchain.mjs --fix",
        "generate:domain-constants": "node scripts/tooling/generate-domain-constants.mjs",
        "wasm:build:rule-engine": "node scripts/tooling/build-rule-engine-wasm.mjs",
        "wasm:ensure:rule-engine": "node scripts/tooling/ensure-rule-engine-wasm.mjs",
        "wasm:clean": "node scripts/tooling/clean-rule-engine-wasm.mjs",
        "lint": "eslint . --ext .ts,.tsx",
        "release:win": "powershell -ExecutionPolicy Bypass -File ./scripts/release/release-win.ps1",
        "release:win-dev": "powershell -ExecutionPolicy Bypass -File ./scripts/release/release-win-dev.ps1",
        "release:web": "powershell -ExecutionPolicy Bypass -File ./scripts/release/release-web.ps1",
        "release-notes:catchup": "bash ./scripts/release/run-release-notes-catchup.sh",
        "test:unit": "npm run wasm:ensure:rule-engine && cargo test --manifest-path wasm/rule_engine_core/Cargo.toml && node scripts/test/run-tests.mjs",
        "bench:pipeline": "npm run wasm:ensure:rule-engine && node node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit false && node scripts/tooling/patch-esm-specifiers.cjs && node --experimental-wasm-modules --import ./tmp/tsc/tests/tests/setup/wasm-warmup.js tmp/tsc/tests/tests/benchmarks/pipeline-perf.bench.js",
        "test:e2e:chromium": "playwright test --project=chromium",
        "test:e2e:firefox": "playwright test --project=firefox",
        "test:e2e": "node scripts/test/run-e2e.mjs",
        "test:e2e:all": "npm run test:e2e",
        "test:all": "npm run test:unit && npm run test:e2e",
        "test:all:full": "npm run test:unit && npm run test:e2e:all",
        "test": "npm run test:all",
        "tests:extract": "tsc -p tsconfig.tests.json && node scripts/tooling/patch-esm-specifiers.cjs && node scripts/test/dump-tests-sfc.mjs"
    },
    "overrides": {
        "esbuild": ">=0.24.3",
        "rehype-prism-plus": "^2.0.2"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.2",
        "@mui/material": "^7.3.2",
        "@mui/x-charts": "^8.28.0",
        "@tanstack/react-virtual": "^3.13.12",
        "@types/node": "^25.3.5",
        "@uiw/react-markdown-preview": "^5.1.1",
        "@uiw/react-md-editor": "^4.0.5",
        "fflate": "^0.8.2",
        "html-to-image": "^1.11.13",
        "react": "^19.2.4",
        "react-compiler-runtime": "^1.0.0",
        "react-dom": "^19.2.4",
        "refractor": "^5.0.0",
        "rehype-sanitize": "^6.0.0",
        "sql.js": "^1.11.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^2.13.0",
        "@playwright/test": "^1.56.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.43.0",
        "@typescript-eslint/parser": "^8.43.0",
        "@vitejs/plugin-react": "^5.1.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "baseline-browser-mapping": "^2.9.11",
        "eslint": "^9.35.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.2",
        "terser": "^5.44.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1",
        "vite-plugin-checker": "^0.12.0"
    }
}
